[Unit]
Description=Initialize RTC Backup Mode (RV-3028)
DefaultDependencies=no
# Ensure I2C bus drivers are ready
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
# Force load the driver since it is a module (=m)
ExecStartPre=/sbin/modprobe rtc-rv3028
# Run your verification script
ExecStart=/usr/local/bin/check-rtc-lsm.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target