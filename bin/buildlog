#!/bin/sh
#
# Check nexus-build for evidence of failures.
#

PROG=$(basename $0)
smso=$(tput smso)
rmso=$(tput rmso)

test -f .defs.mk || {
    # Set "n" in the environment to your nexus-build workdir for convenience
    test -z "$n" || { echo "$PROG: Using directory $n"; cd "$n"; }
    test -f .defs.mk || {
        echo "$PROG: This must be run in a nexus-build working tree" >&2
        exit 1
    }
}

# "Progress" patterns during build.
P='^(===|###|E:|W:|.* - INFO - Running .* in) '
# Noise to ignore in the above.
PIGN='^(W: analyze_copyright|E: Module .* is not signed!)'
H='====================='

TS=typescript
if [ -f "$TS" ]; then
    # Ensure we are not running under script because egrep of typescript
    # will add matching lines to typescript itself and never finish.
    ARGS="$@"
    pid=$$
    while test $pid != 1
    do
        exe=/proc/$pid/exe
        test -f "$exe" || break
        if expr $(readlink $exe) : '.*/script' > /dev/null; then
            echo "$PROG: You seem to be running this under 'script'" >&2
            echo "$PROG: This will cause breakage.  Use another window." >&2
            exit 1
        fi
        set -- $(cat /proc/$pid/stat)
        pid="$4"  # ppid
    done
    set -- $ARGS

    # Show build progress log, with live tail if an arg given
    if [ $# = 1 ]; then
        tail -c +0 -F $TS | egrep -v "$PIGN" | egrep --color=always "$P"
    else
        egrep -v "$PIGN" $TS | egrep --color=always "$P"
    fi

    FILES=$TS
else
    FILES='*.ERR *.out'
    echo "No $TS found so cannot check it for progress or build failures."
    echo "Using $FILES instead."

    # Show build progress log
    cat $FILES 2> /dev/null | egrep -v "$PIGN" | egrep --color=always "$P"
fi

echo
echo "$H Possible failures in $FILES"

# egrep for errors followed by removing known false positives
cat $FILES 2> /dev/null | \
    egrep '(fatal:| error:|^\*\*\*|dpkg: error )' |
    egrep -v '(Linking the executable xfrmi|libstrongswan-kernel-netlink.so is not portable|unable to read /etc/init.d/iperf3|/usr/sbin/grub-probe|bash-completion-test-subject.deb|NOTE: Filtering of link-warnings enabled)'
echo $H

# Check for failure to eventually create .deb files as well as
# suspiciously small ones.
. ./.defs.mk
for i in $IGOS_PKGS
do
    d=vyos-build/scripts/package-build-iGOS/$i
    for deb in $d/*.deb
    do
        # Check for missing completely.
        test -f $deb || {
            echo "${smso}BUILD FAILURE:${rmso} $d contains no .deb files!"
            break
        }

        # Check for suspiciously small size.
        siz=$(stat -c %s $deb)
        if [ "$siz" -lt 512 ]; then
            echo "${smso}POSSIBLE BUILD FAILURE:${rmso} $deb is very small!"
            ls -l $deb
        fi
    done
done

test -f .image.built || {
    echo "$PROG: ${smso}INCOMPLETE BUILD${rmso} (.image.built not found)" >&2
    echo "$PROG: Any diagnostics above are suspect" >&2
}
