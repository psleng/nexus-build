#!/bin/sh
#
# This is called by iGOS-daily-build as builduser
#

# set -x
if [ "$LOGNAME" != "builduser" ]; then
    echo "$0: This must be run by builduser who has access to" >&2
    echo "$0: https://github.com/Perle-Systems-Limited" >&2
    exit 1
fi

if [ -z "$1" ]; then
    echo "Usage: $0 builddir" >&2
    exit 1
fi

cd "$1"
if [ "`pwd`" = "$HOME" ]; then
    echo "$0: Refusing to run in home directory; unsafe!" >&2
    exit 2
fi

umask 002

set -e

sudo rm -rf nexus-build
git clone -q https://github.com/psleng/nexus-build
cd nexus-build

## TODO HACK BEGIN
# echo "HACK stuffing in psl-progs and Makefile.hack to `pwd`"
# cp -r $HOME/psl-progs package-build-iGOS
# mv -f Makefile Makefile.dist
# cp    $HOME/Makefile.hack Makefile
# ls -l
## TODO HACK END

set +e

echo "=== I: Starting daily iGOS build in `realpath .`..."
make spotless
sudo rm -rf ../nightly_isos
mkdir -p ../nightly_isos
date

#TARGS='targ-ti-j7200 targ-ti-am64x targ-perle-iolan'
# 20260420: do not bother with 7200 for now and build am64x last since
#           it is still the most in use.
TARGS='targ-perle-igos targ-ti-am64x'
for T in $TARGS
do
    echo "=== I: Starting $T iGOS build at $(date)..."
    # make mostlyclean
    make variantclean
    sudo rm -rf iso-images
    if [ "$T" = "targ-perle-igos" ]; then
       echo "Setting uboot secure build for igos target" >&2
       IGOS_SECURE=1 make $T
    else
       make $T
    fi
    msg=''
    make all || msg="status=$?"
    echo "=== I: Finished $T iGOS build at $(date) $msg"
    ls -l .*built
    # Stash the .ERR files for this build
    E=errorfiles/$T
    rm -rf $E; mkdir -p $E; cp -pf *.ERR $E

    NIGHTLY_SUBDIR=$(ls -t iso-images | head -n 1)
    if [ -n "$NIGHTY_SUBDIR"]; then
        mkdir -p ../nightly_isos/"${NIGHTLY_SUBDIR}"
    else
        echo "Could not find generated iso in 'iso-images' subdir, skipping"
        continue
    fi
    # Everything outside of EVM build should have an image-version.json, which can be read to determine what iso to use/copy
    # Otherwise for EVM builds, look for keyword 'evm' in the .iso name and copy those over
    if [ "$T" != "targ-ti-am64x" ]; then
        if [ -f "vyos-build/build/image-version.json" ]; then
            IMAGE=$(jq -er ".[].image" vyos-build/build/image-version.json)
            if [ -n "$IMAGE" ]; then
                FILES=$(find vyos-build/build/ -maxdepth 1 -type f -name "${IMAGE}*")
                COUNT=$(echo "$FILES" | wc -w)
                if [ "$COUNT" -eq 2 ]; then
                    cp $FILES ../nightly_isos/"${NIGHTLY_SUBDIR}"
                    cp vyos-build/build/image-version.json ../nightly_isos/"${NIGHTLY_SUBDIR}"
                else
                    echo "Could not determine the exact files to copy to latest iso folder, since we expect only .iso and .minisig and found this: ${FILES}" >&2
                fi
            else
                echo "Could not read .image to determine what files to transfer"
            fi
        else
            echo "Could not find image-version.json, cannot upload latest" >&2
        fi
    else
        FILES=$(find vyos-build/build/ -maxdepth 1 -type f -name "*evm-arm64.iso*")
        COUNT=$(echo "$FILES" | wc -w)
        if [ "$COUNT" -eq 2 ]; then
            cp $FILES ../nightly_isos/"${NIGHTLY_SUBDIR}"
        else
            echo "Could not determine the exact files to copy to latest iso folder, since we expect only .iso and .minisig and found this: ${FILES}" >&2
        fi
    fi
done

echo '=== I: Daily iGOS build completed! Please check *.ERR files for errors.'
