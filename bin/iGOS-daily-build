#!/bin/bash
#
# iGOS daily build
#
# This should be called by cron, something like this:
#
# 00 22 * * * script -e -c /home/psleng/buildprogs/iGOS-daily-build all.out

# set -x
D=$(dirname $(realpath -s $0))

# Set up a nexus-build dir for builduser which must be a member of the 
# same Unix group as psleng with directory write access
umask 002
cd
mkdir -p build
chmod g+wx build

## TODO HACK BEGIN use the big data mount instead for testing
# set -e
# HACK=/data/home/phedman/build
# sudo rm -rf $HACK
# mkdir -p $HACK
# rmdir build
# ln -s $HACK .
## TODO HACK END

# Do full build as builduser
cd build
sudo su - builduser -c "$D/full-build $(pwd)" > full-build.out 2>&1

# Update psleng.github.io with all the .deb files
exec > iGOS-deb-repo.out 2>&1
cd nexus-build
echo 'Checking iGOS binary repository for changes and updating if different.'
./check-update-apt-repo.sh --repo git@github.com:psleng --clean
echo status=$?
