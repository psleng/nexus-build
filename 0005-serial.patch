--- /dev/null	2025-02-19 10:39:48.396000000 -0500
+++ linux-6.6.69/drivers/char/fanout.c	2025-02-19 15:18:41.776654822 -0500
@@ -0,0 +1,409 @@
+/*
+ *  fanout.c:  A one-to-many multiplexer
+ *
+ */
+//#define FANOUT_IOC_MAGIC    'k'
+//#define FANOUT_IOCT_FLUSH     _IO(FANOUT_IOC_MAGIC, 0x80)
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/poll.h>
+#include <linux/cdev.h>
+#include <linux/slab.h>
+#include <asm/uaccess.h>
+#include <asm/ioctls.h>
+#include <linux/sched.h>
+#include <linux/wait.h>
+//#include <linux/devfs_fs_kernel.h>
+
+// this function was removed from include /asm-arm/semaphore.c in kernel 2.6
+// define it here so we don't need to change the code
+static inline void init_MUTEX(struct semaphore *sem)
+{
+    sema_init(sem, 1);
+}
+
+
+/* Limits and other defines */
+	/* The # fanout devices.  Max minor # is one less than this */
+#ifdef CONFIG_FANOUT_NUM_DEVS
+#define NUM_FO_DEVS CONFIG_FANOUT_NUM_DEVS
+#else
+#define NUM_FO_DEVS 49
+#endif
+#define DEVNAME "fanout"
+
+
+
+/* Data structure definitions */
+	/* This data structure describes one fanout device.  There
+	 * is one of these for each instance (minor #) of fanout */
+struct fo {
+	int	minor;		/* minor number of this fanout instance */
+	char   *buf;		/* points to circular buffer */
+	int	indx;		/* where to put next char recv'd */
+	loff_t	count;		/* number chars received */
+    loff_t  read_offset;    // offset of where to start reading for new opens
+                            // the app must make an IOCTL(FANOUT_IOCT_READMARK) to set this to f_pos
+	wait_queue_head_t waitq; /* readers wait on this queue */
+	struct semaphore wlock;	/* write lock to keep buf/indx sane */
+};
+
+
+
+/*  Function prototypes.  */
+int fanout_init(void);
+void fanout_exit(void);
+static int fanout_open(struct inode *, struct file *);
+static int fanout_release(struct inode *, struct file *);
+static ssize_t fanout_read(struct file *, char *, size_t, loff_t *);
+static ssize_t fanout_write(struct file *, const char *, size_t, loff_t *);
+static unsigned int fanout_poll(struct file *, poll_table *);
+static long fanout_ioctl(struct file *, unsigned int, unsigned long);
+
+
+
+/* Global variables */
+#ifdef CONFIG_FANOUT_BUF_SZ
+static int buf_sz = CONFIG_FANOUT_BUF_SZ;		/* Size of the circular buffer */
+#else
+static int buf_sz = 16384;		/* Size of the circular buffer */
+#endif
+	/* Debuglvl controls whether a printk is executed
+	 * 	0 = no printk at all
+	 *	1 = printk on error only
+	 *	2 = printk on errors and on init/remove
+	 *	3 = debug prink to trace calls into fanout
+	 *	4 = debug trace inside of fanout calls */
+     
+#ifdef CONFIG_FANOUT_DEBUG_LVL
+static int debuglvl = CONFIG_FANOUT_DEBUG_LVL;		/* printk verbosity */
+#else
+static int debuglvl = 2;		/* printk verbosity */
+#endif
+
+static int debugec = 0;
+
+#ifdef CONFIG_FANOUT_MAJOR_DEV
+static int devmajor = CONFIG_FANOUT_MAJOR_DEV;        // 0 measn dynamically assign one
+#else
+static int devmajor = 0;        // 0 measn dynamically assign one
+#endif
+
+struct fo fodevs[NUM_FO_DEVS];		/* fanout devices */
+struct cdev fo_cdev;
+dev_t fo_devt;
+
+static struct file_operations fanout_fops = {
+	.owner = THIS_MODULE,
+	.read = fanout_read,
+	.open = fanout_open,
+	.write = fanout_write,
+    .unlocked_ioctl = fanout_ioctl,
+	.poll = fanout_poll,
+	.release = fanout_release
+};
+
+
+
+/* Module description and macros */
+MODULE_DESCRIPTION("A device to replicate input on all outputs");
+MODULE_AUTHOR("Bob Smith");
+MODULE_LICENSE("GPL");
+module_param(buf_sz, int, S_IRUSR);
+MODULE_PARM_DESC(buf_sz, "Size of each circular buffer.  Def=16k");
+module_param(debuglvl, int, S_IRUSR);
+MODULE_PARM_DESC(debuglvl, "Debug level. Higher=verbose. Def=2");
+module_param(devmajor, int, S_IRUSR);
+MODULE_PARM_DESC(devmajor, "Device major number Def=dynamic");
+module_init(fanout_init);
+module_exit(fanout_exit);
+
+
+
+int fanout_init(void)
+{
+	int i, err;
+
+printk("%s %d %d\n", __FUNCTION__,__LINE__,NUM_FO_DEVS);
+	for (i = 0; i < NUM_FO_DEVS; i++) {
+		fodevs[i].minor = i;
+		fodevs[i].buf = (char *) 0;
+		fodevs[i].indx = 0;
+		fodevs[i].count = 0;
+        fodevs[i].read_offset = 0;
+		init_waitqueue_head(&fodevs[i].waitq);
+		init_MUTEX(&fodevs[i].wlock);
+	}
+printk("%s %d %d\n", __FUNCTION__,__LINE__,devmajor);
+    if (devmajor==0)
+    {
+        err = alloc_chrdev_region(&fo_devt, 0, NUM_FO_DEVS, DEVNAME);
+    }
+    else
+    {
+        fo_devt = MKDEV(devmajor, 0);
+        err = register_chrdev_region(fo_devt, NUM_FO_DEVS, DEVNAME);
+    }
+    if (err < 0) {
+        if (debuglvl >= 1) {
+            printk(KERN_ALERT "fanout-%d: init fails. err=%d\n", debugec++,err);
+        }
+        return err;
+    }
+    devmajor = MAJOR(fo_devt);
+	cdev_init(&fo_cdev, &fanout_fops);
+	kobject_set_name(&(fo_cdev.kobj), "fanout%d", fo_devt);
+
+	err = cdev_add(&fo_cdev, fo_devt, NUM_FO_DEVS);
+	if (err < 0) {
+		if (debuglvl >= 1) {
+			printk(KERN_ALERT "fanout-%d: init fails. err=%d\n", debugec++, err);
+		}
+		return err;
+	}
+
+	if (debuglvl >= 2) {
+		printk(KERN_INFO "fanout-%d: Installed, Device Major=%d, buf_sz=%d, debuglvl=%d\n",debugec++,devmajor,buf_sz,debuglvl);
+	}
+
+	return 0;  /* success */
+}
+
+
+void fanout_exit(void)
+{
+	int i;
+
+	for (i = 0; i < NUM_FO_DEVS; i++) {
+		if (fodevs[i].buf) {
+			kfree(fodevs[i].buf);
+		}
+	}
+
+	cdev_del(&fo_cdev);
+	unregister_chrdev_region(fo_devt, NUM_FO_DEVS);
+
+	if (debuglvl >= 2) {
+		printk(KERN_INFO "fanout-%d: Uninstalled\n",debugec++);
+	}
+}
+
+
+static int fanout_open(struct inode *inode, struct file *filp)
+{
+	int mnr = iminor(inode);
+	struct fo *fodp = &fodevs[mnr];
+
+	if (debuglvl >= 3) {
+		printk(KERN_DEBUG "fanout-%d open. Minor#=%d\n", debugec++, mnr);
+	}
+
+	if (!fodp->buf) {
+		fodp->buf = kmalloc(buf_sz, GFP_KERNEL);
+		if (debuglvl >= 3) {
+			printk(KERN_DEBUG "fanout-%d: Got memory for minor=%d\n",
+					debugec++,mnr);
+		}
+		if (!fodp->buf) {
+			if (debuglvl >= 1) {
+				printk(KERN_ALERT "fanout-%d: No memory dev=%d\n",
+						debugec++, mnr);
+			}
+			return -ENOMEM;
+		}
+	}
+
+	/* store which fanout device in the file's private data */
+	filp->private_data = (void *) fodp;
+
+	/* set the current start of file */
+	filp->f_pos = fodp->count;
+    if (filp->f_mode & FMODE_READ)
+    {
+        if (fodp->read_offset == 0)
+        {
+            if (fodp->count > buf_sz)
+            {
+                filp->f_pos=fodp->count-buf_sz;
+            }
+            else
+            {
+                filp->f_pos=0;
+            }
+        }
+        else
+        {
+            filp->f_pos=fodp->read_offset;
+        }
+    }
+
+	return 0;	/* success */
+}
+
+static int fanout_release(struct inode *inode, struct file *filp)
+{
+	if (debuglvl >= 3) {
+		printk(KERN_DEBUG "fanout-%d close. Minor#=%d\n", debugec++,
+			((struct fo *)filp->private_data)->minor);
+	}
+
+	return 0;	/* success */
+}
+
+
+
+static ssize_t fanout_read( struct file *filp, char *buff, size_t len,
+	loff_t * offset)
+{
+	int ret, xfer;			/* num bytes read from fanout buf */
+	int cpcnt, cpstrt;		/* cp count and start location */
+
+	struct fo *fodp = (struct fo *)filp->private_data;
+
+	if (debuglvl >= 3) {
+		printk(KERN_DEBUG "fanout-%d: read %d char from dev%d, off=%d f_pos=%d count=%d\n",debugec++,
+			len, fodp->minor, (int)*offset,(int)filp->f_pos,(int)fodp->count);
+        printk(KERN_DEBUG "fanout-%d read fmode=%x\n", debugec++, filp->f_mode);
+	}
+
+	/* Verify that data requested is in the buffer or is next byte */
+	xfer = fodp->count - *offset;
+	if ((xfer > buf_sz) || (xfer < 0)) {
+        fodp->read_offset=0;
+		return -EPIPE;
+	}
+
+	/* Wait here until new data is available */
+	if (*offset == fodp->count) {
+		wait_event_interruptible(fodp->waitq, *offset != fodp->count);
+	}
+
+	/* Copy the data out to the user */
+	xfer = fodp->count - *offset;
+    cpstrt=fodp->indx-xfer;
+    if (cpstrt < 0)
+    {
+        cpstrt+=buf_sz;
+    }
+	ret = xfer = (len < xfer) ? len : xfer;
+	while (xfer) {
+        cpcnt=buf_sz-cpstrt;
+        cpcnt=(cpcnt < xfer) ? cpcnt : xfer;
+
+		if (copy_to_user(buff, fodp->buf + cpstrt, cpcnt) ) {
+			return -EFAULT;
+		}
+		buff += cpcnt;
+		xfer -= cpcnt;
+        cpstrt += cpcnt;
+        cpstrt = (cpstrt == buf_sz) ? 0 : cpstrt;
+	};
+
+	/* We may have slept during the above copy_to_user() and more
+	 * data may have been added while we slept.  Do a sanity check
+	 * to make sure the buffer did not wrap while we slept. */
+	if (fodp->count - *offset > buf_sz) {
+        fodp->read_offset=0;
+		return -EPIPE;
+	}
+
+	*offset += ret;
+
+	return ret;
+}
+
+
+static ssize_t
+fanout_write(struct file *filp, const char *buff, size_t len, loff_t * off)
+{
+	int ret, xfer;		/* num bytes to read from user */
+	int cpcnt;		/* num bytes in a copy */
+
+	struct fo *fodp = (struct fo *)filp->private_data;
+
+	if (debuglvl >= 3) {
+		printk(KERN_DEBUG "fanout-%d: write %d char to dev%d, off=%d\n", debugec++,
+			len, fodp->minor, (int)*off);
+        printk(KERN_DEBUG "fanout-%d write fmode=%x\n", debugec++, filp->f_mode);
+	}
+
+	/* Copy at most one-quarter of the circular buffer size.  This
+	 * gives readers more of a chance to wake up and get some data */
+//	ret = xfer = (len > (buf_sz / 4)) ? (buf_sz / 4) : len;
+	ret = xfer = len;
+
+	if (down_interruptible(&fodp->wlock)) {
+		return -ERESTARTSYS;
+	}
+
+	while (xfer) {
+		cpcnt = buf_sz - fodp->indx;
+		cpcnt = (cpcnt < xfer) ? cpcnt : xfer;
+
+		/* Don't we need a lock of some kind here ? */
+		if (copy_from_user(fodp->buf + fodp->indx, buff, cpcnt) ) {
+			up(&fodp->wlock);
+			return -EFAULT;
+		}
+		fodp->indx += cpcnt;
+		fodp->indx = (fodp->indx == buf_sz) ? 0 : fodp->indx;
+		xfer -= cpcnt;
+		buff += cpcnt;
+	}
+	fodp->count += ret;
+	up(&fodp->wlock);
+
+	/* This is what the readers have been waiting for */
+	wake_up_interruptible(&(fodp->waitq));
+
+	return ret;
+}
+
+
+static unsigned int fanout_poll(struct file *filp, poll_table *ppt)
+{
+	/* The circular buffer is always available for writing */
+	int ready_mask = POLLOUT | POLLWRNORM;
+
+	struct fo *fodp = (struct fo *)filp->private_data;
+
+	poll_wait(filp, &fodp->waitq, ppt);
+
+	if (filp->f_pos != fodp->count) {
+		ready_mask = (POLLIN | POLLRDNORM);
+	}
+
+	if (debuglvl >= 3) {
+		printk(KERN_DEBUG "fanout-%d: poll returns 0x%x\n", debugec++, ready_mask);
+	}
+
+	return ready_mask;
+}
+
+static long fanout_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+    struct fo *fodp = (struct fo *)filp->private_data;
+    
+    if (debuglvl >= 3) {
+        printk(KERN_DEBUG "fanout-%d: ioctl cmd=%x %x\n", debugec++,cmd,FANOUT_IOCT_FLUSH);
+    }
+    switch(cmd)
+    {
+        case FANOUT_IOCT_FLUSH:
+            fodp->indx=0;
+            fodp->count=0;
+            fodp->read_offset=0;
+            wake_up_interruptible(&(fodp->waitq));  // wake up readers
+            return(0);
+            
+        case FANOUT_IOCT_READMARK:
+            fodp->read_offset=filp->f_pos;
+            return(0);
+            
+        default:
+            return(-EINVAL);
+    }
+}
+

