+static int tiocmapXXX_handler(struct uart_port *port,unsigned long arg,unsigned int cmd)
+{
+    struct uart_8250_port *up = up_to_u8250p(port);
+    unsigned int bits;
+
+    if (copy_from_user(&bits, (unsigned int *)arg, sizeof(int)))
+    {
