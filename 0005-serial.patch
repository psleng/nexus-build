+        up->port.icount.dsr=0;
+    }
+    if (resetControl & TIOCCICOUNT_RNG)
+    {
+        up->port.icount.rng=0;
+    }
+    if (resetControl & TIOCCICOUNT_DCD)
+    {
+        up->port.icount.dcd=0;
+    }
+    if (resetControl & TIOCCICOUNT_TX)
+    {
+        up->port.icount.tx=0;
+    }
+    if (resetControl & TIOCCICOUNT_RX)
+    {
+        up->port.icount.rx=0;
+    }
+    if (resetControl & TIOCCICOUNT_FRAME)
+    {
+        up->port.icount.frame=0;
+    }
+    if (resetControl & TIOCCICOUNT_PARITY)
+    {
+        up->port.icount.parity=0;
+    }
+    if (resetControl & TIOCCICOUNT_OVERRUN)
+    {
+        up->port.icount.overrun=0;
+    }
+    if (resetControl & TIOCCICOUNT_BRK)
+    {
+        up->port.icount.brk=0;
+    }
+    if (resetControl & TIOCCICOUNT_BUFOVERRUN)
+    {
+        up->port.icount.buf_overrun=0;
+    }
+}
+void debug_printk_ioctl(struct uart_port *uart_port,unsigned int cmd)
+{
+    int i;
+    int found=0;
+    static int do_once=0;
+
+
+    if (do_once==0)
+    {
+        for (i=0;strlen(perle_ioctl[i].cmd_str)!=0;i++)
+        {
+            pr_err("(%s,%s,%d): %s=(0x%08x)\n",
+                __FILE__,
+                __FUNCTION__,
+                __LINE__,
+                perle_ioctl[i].cmd_str,
+                perle_ioctl[i].cmd);
+        }
+        do_once=1;
+    }
+
+    for (i=0;strlen(perle_ioctl[i].cmd_str)!=0;i++)
+    {
+        if (perle_ioctl[i].cmd==cmd)
+        {
+            pr_err("(%s,%s,%d): port=(%d), cmd=(0x%08x,%s)\n",
+                    __FILE__,
+                    __FUNCTION__,
+                    __LINE__,
+                    uart_port->line,
+                    cmd,
+                    perle_ioctl[i].cmd_str);
+            found=1;
+            break;
+        }
+    }
+
+    if (!found)
+    {
+        pr_err("(%s,%s,%d): port=(%d), cmd=(0x%08x)\n",
+                __FILE__,
+                __FUNCTION__,
+                __LINE__,
+                uart_port->line,
+                cmd);
+    }
+}
