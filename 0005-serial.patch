+#ifdef CONFIG_SERIAL_8250_OMAP_TTYO_FIXUP
+
+#include <linux/slab.h>
+
+#define CMDLINE_SIZE 1024  // Ensure buffer is large enough
+
+char *read_cmdline(void) {
+    struct file *f;
+    char *buf;
+    ssize_t bytes_read;
+    loff_t pos = 0;
+
+    // Allocate memory for the command line
+    buf = kzalloc(CMDLINE_SIZE, GFP_KERNEL);
+    if (!buf) {
+        pr_err("Failed to allocate memory for command line\n");
+        return NULL;
+    }
+
+    // Open /proc/cmdline
+    f = filp_open("/proc/cmdline", O_RDONLY, 0);
+    if (IS_ERR(f)) {
+        pr_err("Failed to open /proc/cmdline\n");
+        kfree(buf);
+        return NULL;
+    }
+
+    // Read command line
+    bytes_read = kernel_read(f, buf, CMDLINE_SIZE - 1, &pos);
+    filp_close(f, NULL);
+
+    if (bytes_read <= 0) {
+        pr_err("Failed to read /proc/cmdline\n");
+        kfree(buf);
+        return NULL;
+    }
+
+    buf[bytes_read] = '\0'; // Ensure null termination
+    return buf;  // Return the allocated buffer
+}
+
+// Not sure if this was ever called
+static int __init perleomap8250_console_fixup(void)
+{
+    char *omap_str;
+    char *options;
+    u8 idx;
+
+char *cmdline = read_cmdline();
+if (cmdline)
+{
+    if (strstr(cmdline, "console=ttyS"))
+    {
+        /* user set a ttyS based name for the console */
+    kfree(cmdline);
+        return 0;
+    }
+    omap_str = strstr(cmdline, "console=ttyO");
+    if (!omap_str)
+    {
+    kfree(cmdline);
+        /* user did not set ttyO based console, so we don't care */
+        return 0;
+    }
+    kfree(cmdline);
+}
+    omap_str += 12;
+    if ('0' <= *omap_str && *omap_str <= '9')
+        idx = *omap_str - '0';
+    else
+        return 0;
+
+    omap_str++;
+    if (omap_str[0] == ',') {
+        omap_str++;
+        options = omap_str;
+    } else {
+        options = NULL;
+    }
+
+    // add_preferred_console("ttyS", idx, options);
+    pr_err("WARNING: Your 'console=ttyO%d' has been replaced by 'ttyS%d'\n",
+        idx, idx);
+    pr_err("This ensures that you still see kernel messages. Please\n");
+    pr_err("update your kernel commandline.\n");
+    return 0;
+}
