+static inline void perleserial8250_out_MCR(struct uart_8250_port *up, int value)
+{
+
+    ////printk_deferred("%s()@%d: value %x\n",__FUNCTION__,__LINE__,value);
+    
+    if (up->port.rs485.flags & SER_RS422_ENABLED)
+    {
+        value |= UART_MCR_RTS;
+        ////printk_deferred("%s()@%d: forcing rts in 422 value %x\n",__FUNCTION__,__LINE__,value);
+    }
+
+
+
+    
+	serial_out(up, UART_MCR, value);
+    up->last_mcr_written=value;
+    fix_port_mctrl_from_mcr(up);
+    if(up->traceMask & TRACE_BITS_SIGNALS)
+    {
+        uartTraceAddSignals(up->tracePortIndex, &up->traceSignals, value, up->last_msr_read);
+    }
+	if (up->gpios)
+		mctrl_gpio_set(up->gpios, serial8250_MCR_to_TIOCM(value));
+}
