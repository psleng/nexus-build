+static int tsigscan_handler(struct uart_port *port,unsigned long arg)
+{
+    unsigned long flags;
+    struct uart_8250_port *up = up_to_u8250p(port);
+    // struct mctrl_gpios *gpios = up->gpios;
+    struct sigscan sigCopy;
+    int returnCode=0;
+
+    do
+    {
+        if(copy_from_user(&sigCopy, (struct sigscan *)arg, sizeof(struct sigscan)))
+        {
+            returnCode = -EFAULT;
+            break;
+        }
+
+        // incase other CPU runs during del_timer_sync() we must be unlocked...
+        fsmSigScan(up, FSMSS_EXIT, 0,2);
+
+        spin_lock_irqsave(&port->lock, flags);
+        if(sigCopy.pid != 0 && sigCopy.sigmask != 0)
+        {
+            memcpy(&up->sigScan, &sigCopy, sizeof(struct sigscan));
+            fsmSigScan(up, FSMSS_SCAN, 0,3);
+            fsmSigScan(up, FSMSS_TIOCM, up->mctrl_prev,4);
+            //fsmSigScan(up, FSMSS_TIOCM, MSR2TIOCM((unsigned char)up->last_msr_read),4);
+            //fsmSigScan(up, FSMSS_TIOCM, (unsigned char)up->last_msr_read,4);
+            ////printk_deferred("%s,%d: mctrl_prev %x \n", __func__, __LINE__, up->mctrl_prev);
+        }
+        // else if(sigCopy.sigdrop)    // allow drop only function
+        // {
+        //     returnCode=set_modem_info(up, TIOCMBIC, sigCopy.sigdrop);
+        // }
+        spin_unlock_irqrestore(&port->lock, flags);
+
+    }while(0);
+
+    return(returnCode);
+}
+static void tioccicount_handler(struct uart_port *port,unsigned long arg)
+{
