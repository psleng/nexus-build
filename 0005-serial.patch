+int serial8250_ioctl(struct uart_port *port, unsigned int cmd, unsigned long arg)
+{
+    int ret = 0;
+    //printk("%s,%d: cmd %d\n", __func__, __LINE__, cmd);
+    switch(cmd)
+    {
+        case TRPTSET:
+            ret=trptset_handler(port,arg);
+            // printk("%s,%d: TRPTSET ret %d\n", __func__, __LINE__, ret);
+            break;
+        case TRPTGET:
+            ret=trptget_handler(port,arg,0);  // no reset
+            // printk("%s,%d: TRPTGET ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        case TRPTGETRST:
+            ret=trptget_handler(port,arg,1);    // with reset
+            // printk("%s,%d: TRPTGETRST ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        case TRPTSETPID:
+            trptsetpid_handler(port,arg);
+            break;
+
+        case TIOCFWDDS:
+            ret=perle_set_forwarding(port,arg);
+            // printk("%s,%d: TIOCFWDDS ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        case TIOCMAPDTR:
+        case TIOCMAPRTS:
+            ret=tiocmapXXX_handler(port,arg,cmd);
+            ////printk("%s,%d: TIOCMAPRTS  TIOCMAPDTR ret %d\n", __func__, __LINE__, ret);
+            break;
+        case TRACECONTROL:
+            ret=tracecontrol_handler(port,arg);
+            break;
+
+        case TRACEREAD:
+            ret=traceread_handler(port,arg);
+            break;
+
+        case TIOCOSARMDS:
+            tiocosarmds_handler(port);
+            ////printk("%s,%d: TIOCOSARMDS ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        case TRESETCOUNT:
+            ret=tresetcount_handler(port,arg);
+            ////printk("%s,%d: TRESETCOUNT ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        case TSIGSCAN:
+            ret=tsigscan_handler(port,arg);
+            ////printk("%s,%d: TSIGSCAN ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        case TIOCCICOUNT:
+            tioccicount_handler(port,arg);
+            ////printk("%s,%d: TIOCCICOUNT ret %d\n", __func__, __LINE__, ret);
+            break;
+        case TRTSCONTROL:
+            ret=perle_set_rts_toggle(port,arg);
+            ////printk("%s,%d: TRTSCONTROL ret %d\n", __func__, __LINE__, ret);
+            break;
+
+        default:
+            ret=(-ENOIOCTLCMD);
+            break;
+    }
+    return ret;
+}
