+static bool handle_rx_dma(struct uart_8250_port *up, unsigned int iir)
+{
+    switch (iir & 0x3f) {
+    case UART_IIR_RLSI:
+    case UART_IIR_RX_TIMEOUT:
+    case UART_IIR_RDI:
+        omap_8250_rx_dma_flush(up);
+        return true;
+    }
+    return omap_8250_rx_dma(up);
+}
