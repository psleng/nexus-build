+    if (rts_toggle_config.flags & RTS_TOGGLE_ON)
+        up->rs232_rts_toggle = 1;
+    else
+        up->rs232_rts_toggle = 0;
+
+    up->rts_toggle_initial_delay = rts_toggle_config.initial_delay;
