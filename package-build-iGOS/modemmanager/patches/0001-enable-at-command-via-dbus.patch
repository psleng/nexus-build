Description: Enable AT command passthrough via D-Bus.
 By default ModemManager exposes org.freedesktop.ModemManager1.Modem.Command()
 only when started with --debug.  Building with -Dat_command_via_dbus=true
 removes that gate so the FSM can issue AT commands over the system bus in
 production.
Author: VyOS / iGOS WWAN team
Last-Update: 2026-04-30
Forwarded: not-needed

--- a/debian/rules
+++ b/debian/rules
@@ -21,5 +21,6 @@
 override_dh_auto_configure:
 	dh_auto_configure -- $(configure_flags) \
 		-Ddbus_policy_dir=/usr/share/dbus-1/system.d \
+		-Dat_command_via_dbus=true \
 		-Dpolkit=permissive \
 		-Dvapi=true
